apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: nexus-pass-vault
  namespace: default
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-prod
spec:
  ingressClassName: traefik
  tls:
    - hosts:
        - nexuspassvault.dasmido.dev
      secretName: nexus-pass-vault-tls
  rules:
    - host: nexuspassvault.dasmido.dev
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: nexus-pass-vault
                port:
                  name: http